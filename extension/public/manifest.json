{
  "manifest_version": 3,
  "key": "",
  "name": "Hanger",
  "version": "0.1.0",
  "description": "Try on any garment from any shop, keep it in Your Hanger, and build outfits across retailers.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Hanger"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": ["http://localhost:8787/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
