# Copy to server/.env. Every value here is optional — with none of them set,
# Hanger runs in mock mode end to end and spends nothing.

# Mock mode returns fixtures instead of calling the live API. Leave it true
# while building; set it to false only to verify integration or record a demo.
MOCK_MODE=true

# YouCam / Perfect Corp bearer key. Required for live try-on.
# Devpost -> redeem code by email -> yce.perfectcorp.com/api-console
# -> Account -> Redeem Code -> API Keys.
# If the console gives you an API ID + Secret pair instead of a single bearer
# key, stop: the auth flow differs from what this build implements.
YOUCAM_API_KEY=

# SerpApi key, for the alternatives search (Google Lens). Free tier: 100 searches.
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Two-letter market for the alternatives search (za, gb, us…). Leave unset and
# each garment's own currency picks it — a ZAR garment searches South Africa.
# Set it only to force every search into one market.
SEARCH_COUNTRY=

# Optional. Only used to clean up messy product titles for the fallback search.
ANTHROPIC_API_KEY=

# Sign-in, from your Clerk dashboard (API keys). Leave both blank to run with no
# accounts at all — the server falls back to a single local user, which is how
# development works and needs no network.
#
# The secret key never leaves the server. The publishable key is designed to be
# public and is what the phone app and the panel are built with.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Soft cap on units spent per install. The server refuses live calls past it.
UNIT_BUDGET=600

# What one visitor may spend before their try-ons come back as samples instead.
# Not a wall — everything keeps working, the results are just watermarked.
# 0 removes the limit. The machine running the server has no limit either way.
USER_UNIT_CAP=20

PORT=8787
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Where the phone app answers, for the pairing QR code only. Leave unset in
# development: this machine's LAN address on the app's dev port is right, and
# typing the six-character code works either way.
PWA_ORIGIN=
DATABASE_PATH=./data/hanger.db
STORAGE_PATH=./storage
